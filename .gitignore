# ========================================================
# SDG SERVER - ROOT .GITIGNORE
# Single common gitignore for the entire workspace
# ========================================================

# Environment Variables (Keep credentials secret)
.env
*.env
.env.*
!.env.example

# Node Dependencies
node_modules/
**/node_modules/

# Build & Output Artifacts
dist/
**/dist/
dist-ssr/
**/dist-ssr/

# All Uploads Folders (Uploaded user files, media & reports)
uploads/
**/uploads/
visitsite/uploads/
visitsite/server/uploads/
web_site3.0/uploads/
web_site3.0/server/uploads/

# Large Database Dumps
*.sql

# Logs
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor & OS Metadata
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.local
