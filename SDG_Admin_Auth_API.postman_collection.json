{
  "info": {
    "_postman_id": "a9d7e63b-1823-4f90-8451-93c3a07db98f",
    "name": "SDG Admin Auth API",
    "description": "Collection for testing SDG Admin authentication, session verification, user creation, and password management.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Admin Login (Save Token)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    const data = pm.response.json();",
              "    pm.environment.set(\"token\", data.token);",
              "    pm.globals.set(\"token\", data.token);",
              "    console.log(\"Saved token:\", data.token);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
        },
        "url": {
          "raw": "http://localhost:8006/api/auth/login",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8006",
          "path": ["api", "auth", "login"]
        },
        "description": "Authenticates user and saves session token into environment variable {{token}} automatically."
      },
      "response": []
    },
    {
      "name": "2. Verify Session",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "http://localhost:8006/api/auth/verify",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8006",
          "path": ["api", "auth", "verify"]
        },
        "description": "Verifies that the bearer token is valid and unexpired."
      },
      "response": []
    },
    {
      "name": "3. Create User / Set Password",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"editor_demo\",\n  \"email\": \"editor_demo@sdg.org\",\n  \"password\": \"SecurePass123!\",\n  \"full_name\": \"Demo Editor\",\n  \"role\": \"admin\"\n}"
        },
        "url": {
          "raw": "http://localhost:8006/api/auth/create-password",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8006",
          "path": ["api", "auth", "create-password"]
        },
        "description": "Creates a new user credential with salted scrypt password hashing."
      },
      "response": []
    },
    {
      "name": "4. Update Password",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"new_password\": \"newpassword456\"\n}"
        },
        "url": {
          "raw": "http://localhost:8006/api/auth/update-password",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8006",
          "path": ["api", "auth", "update-password"]
        },
        "description": "Updates password directly without requiring old password."
      },
      "response": []
    },
    {
      "name": "5. Admin Logout",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "http://localhost:8006/api/auth/logout",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8006",
          "path": ["api", "auth", "logout"]
        },
        "description": "Invalidates the session token in the database."
      },
      "response": []
    }
  ]
}
